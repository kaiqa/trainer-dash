# Application
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=5687
DEBUG=false

# Database (MySQL)
DB_HOST=mysql
DB_PORT=3306
DB_USER=meetings_user
DB_PASSWORD=meetings_password
DB_NAME=meetings_db

# Database URL (alternative to individual settings)
# DATABASE_URL=mysql+pymysql://meetings_user:meetings_password@mysql:3306/meetings_db

# Webhook Configuration (can be overridden via Settings API)
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=5687
WEBHOOK_PATH=/webhook/req-meeting

# CORS
CORS_ORIGINS=["http://localhost:5687", "http://100.66.60.70:5687", "http://100.122.130.97:5687"]

# Logging
LOG_LEVEL=INFO